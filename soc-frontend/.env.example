# ============================================================
# SOC Frontend - exemple de configuration
# Copiez ce fichier vers .env.local puis adaptez les URLs.
# .env.local est ignoré par Git.
# ============================================================

# API FastAPI
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# TheHive (console d'analyse)
NEXT_PUBLIC_THEHIVE_URL=http://localhost:9000

# GLPI (helpdesk / tickets)
NEXT_PUBLIC_GLPI_URL=http://localhost/glpi

# Grafana (monitoring)
NEXT_PUBLIC_GRAFANA_URL=http://localhost:3000
