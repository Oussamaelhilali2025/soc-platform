# ============================================================
# SOC Platform - exemple de configuration
# Copiez ce fichier vers .env puis renseignez vos valeurs.
# Ne commitez jamais le fichier .env réel.
# ============================================================

# --- Application ---
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# --- MariaDB ---
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=soc_platform

# --- CORS (origines autorisées, séparées par des virgules) ---
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Wazuh Manager API ---
WAZUH_API_URL=https://127.0.0.1:55000
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASSWORD=
WAZUH_API_VERIFY_SSL=false
WAZUH_RESPONSE_DRY_RUN=true

# --- Wazuh Indexer / OpenSearch ---
WAZUH_INDEXER_URL=https://127.0.0.1:9200
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASSWORD=
WAZUH_INDEXER_VERIFY_SSL=false

# --- Shuffle SOAR ---
SHUFFLE_URL=http://127.0.0.1:3001

# --- TheHive ---
THEHIVE_URL=http://127.0.0.1:9000
THEHIVE_API_KEY=

# --- GLPI ---
GLPI_URL=http://127.0.0.1/glpi
GLPI_APP_TOKEN=
GLPI_API_TOKEN=

# --- Threat Intelligence ---
VT_API_KEY=
ABUSEIPDB_API_KEY=

# --- OpenVAS / Greenbone ---
OPENVAS_URL=
OPENVAS_USERNAME=
OPENVAS_PASSWORD=
GREENBONE_ADAPTER_URL=http://127.0.0.1:8080
